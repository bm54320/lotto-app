<%- include('layout') %>

    <!-- Status Cards -->
    <div class="stats-grid">
      <div class="card stat-card">
        <div class="stat-number"><%= (typeof ticketCount === 'number') ? ticketCount : '0' %></div>
        <div class="stat-label">Uplaćenih listića</div>
      </div>
      
      <div class="card stat-card">
        <div class="status-badge <%= isActive ? 'status-active' : 'status-inactive' %>">
          <%= isActive ? 'Uplate aktivne' : 'Uplate neaktivne' %>
        </div>
      </div>
    </div>

    <!-- Round Status -->
    <div class="card ticket-info">
      <h2>🎯 Stanje kola</h2>
      <p><strong>Kolo:</strong> <%= (typeof ticketCount === 'number') ? '✅ Postoji' : '❌ Nema kola' %></p>
      <p><strong>Status uplata:</strong> 
        <span class="status-badge <%= isActive ? 'status-active' : 'status-inactive' %>">
          <%= isActive ? 'AKTIVNE' : 'NEAKTIVNE' %>
        </span>
      </p>
    </div>

    <!-- Drawn Numbers -->
    <% if (drawnNumbers && drawnNumbers.length) { %>
    <div class="card drawn-numbers">
      <h2>🎲 Izvučeni brojevi</h2>
      <div class="numbers">
        <% drawnNumbers.forEach(n => { %>
          <span class="ball"><%= n %></span>
        <% }) %>
      </div>
    </div>
    <% } else { %>
    <div class="card">
      <h2>🎲 Izvučeni brojevi</h2>
      <p>Još nisu objavljeni izvučeni brojevi za trenutno kolo.</p>
    </div>
    <% } %>

    <!-- Admin Panel -->
    <div class="card" style="border: 2px solid #3498db; background: #f0f8ff;">
      <h3>⚙️ Admin Panel - Upravljanje kolom</h3>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-top: 20px;">
        
        <!-- Button 1: Aktiviraj novo kolo -->
        <button onclick="activateRound()" class="btn-admin" style="background: #27ae60;">
          🎯 Aktiviraj novo kolo
        </button>
        
        <!-- Button 2: Zatvori kolo -->
        <button onclick="closeRound()" class="btn-admin" style="background: #e74c3c;">
          🔒 Zatvori kolo
        </button>
        
        <!-- Button 3: Unesi izvučene brojeve -->
        <button onclick="showResultsModal()" class="btn-admin" style="background: #9b59b6;">
          🎲 Unesi izvučene brojeve
        </button>
        
        <!-- Button 4: Uplati listić (samo ako je aktivno) -->
        <% if (isActive) { %>
          <a href="/pay" class="btn-admin" style="background: #3498db; text-decoration: none; display: flex; align-items: center; justify-content: center;">
            🎫 Uplati listić
          </a>
        <% } else { %>
          <button class="btn-admin" style="background: #95a5a6; cursor: not-allowed;" disabled>
            🎫 Uplati listić (neaktivno)
          </button>
        <% } %>
      </div>

      <!-- Status poruke -->
      <div id="adminStatus" style="margin-top: 20px; padding: 15px; border-radius: 8px; display: none;"></div>
    </div>

    <!-- Modal za unos izvučenih brojeva -->
    <div id="resultsModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 1000;">
      <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; padding: 30px; border-radius: 12px; max-width: 500px; width: 90%;">
        <h3 style="margin-top: 0;">🎲 Unesi izvučene brojeve</h3>
        <p style="color: #7f8c8d;">Unesite 6 izvučenih brojeva odvojenih zarezom (npr: 5,12,18,23,31,42)</p>
        <input type="text" id="drawnNumbers" placeholder="5,12,18,23,31,42" style="width: 100%; padding: 12px; font-size: 16px; border: 2px solid #ddd; border-radius: 8px; margin: 15px 0;">
        <div style="display: flex; gap: 10px; margin-top: 20px;">
          <button onclick="submitResults()" style="flex: 1; padding: 12px; background: #27ae60; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 16px; font-weight: bold;">
            ✅ Spremi
          </button>
          <button onclick="closeModal()" style="flex: 1; padding: 12px; background: #95a5a6; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 16px; font-weight: bold;">
            ❌ Odustani
          </button>
        </div>
      </div>
    </div>

    <style>
      .btn-admin {
        padding: 15px 20px;
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 16px;
        font-weight: bold;
        transition: all 0.3s;
      }
      .btn-admin:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
      }
      .btn-admin:active:not(:disabled) {
        transform: translateY(0);
      }
    </style>

    <script>
      // Prikaži status poruku
      function showStatus(message, type) {
        const status = document.getElementById('adminStatus');
        status.style.display = 'block';
        status.style.background = type === 'success' ? '#d4edda' : '#f8d7da';
        status.style.color = type === 'success' ? '#155724' : '#721c24';
        status.style.border = `1px solid ${type === 'success' ? '#c3e6cb' : '#f5c6cb'}`;
        status.innerHTML = message;
        setTimeout(() => { status.style.display = 'none'; }, 5000);
      }

      // Aktiviraj novo kolo
      async function activateRound() {
        try {
          showStatus('⏳ Aktiviram kolo...', 'info');
          
          const response = await fetch('/api/admin/activate-round', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });
          
          const data = await response.json();
          
          if (data.success) {
            showStatus('✅ Kolo je aktivirano! Osvježavam stranicu...', 'success');
            setTimeout(() => location.reload(), 1500);
          } else {
            showStatus('❌ Greška: ' + data.message, 'error');
          }
        } catch (error) {
          showStatus('❌ Greška: ' + error.message, 'error');
        }
      }

      // Zatvori kolo
      async function closeRound() {
        try {
          showStatus('⏳ Zatvaram kolo...', 'info');
          
          const response = await fetch('/api/admin/close-round', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });
          
          const data = await response.json();
          
          if (data.success) {
            showStatus('✅ Kolo je zatvoreno! Osvježavam stranicu...', 'success');
            setTimeout(() => location.reload(), 1500);
          } else {
            showStatus('❌ Greška: ' + data.message, 'error');
          }
        } catch (error) {
          showStatus('❌ Greška: ' + error.message, 'error');
        }
      }

      // Prikaži modal za unos brojeva
      function showResultsModal() {
        document.getElementById('resultsModal').style.display = 'block';
      }

      // Zatvori modal
      function closeModal() {
        document.getElementById('resultsModal').style.display = 'none';
        document.getElementById('drawnNumbers').value = '';
      }

      // Spremi izvučene brojeve
      async function submitResults() {
        const input = document.getElementById('drawnNumbers').value;
        const numbers = input.split(',').map(n => parseInt(n.trim())).filter(n => !isNaN(n));
        
        if (numbers.length !== 6) {
          alert('Morate unijeti točno 6 brojeva!');
          return;
        }
        
        try {
          showStatus('⏳ Spremam rezultate...', 'info');
          closeModal();
          
          const response = await fetch('/api/admin/store-results', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ numbers })
          });
          
          const data = await response.json();
          
          if (data.success) {
            showStatus('✅ Rezultati spremljeni! Osvježavam stranicu...', 'success');
            setTimeout(() => location.reload(), 1500);
          } else {
            showStatus('❌ Greška: ' + data.message, 'error');
          }
        } catch (error) {
          showStatus('❌ Greška: ' + error.message, 'error');
        }
      }
    </script>

  </main>
</body>
</html>
